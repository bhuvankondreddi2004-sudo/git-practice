    alt?: string,
    height?: number,
    width?: number,
  }

  export type StringSetterPropKeys<Props> = keyof Props
  export type StringPropertySpec<Props> = {
    type: 'string',
    label?: string,
    defaultValue?: string,
    setter?: StringSetterPropKeys<Props>,
    sortPosition?: number,
    showDividerAbove?: boolean,
  }

  // KEEP_IN_SYNC(web/js/figma_app/views/component_props/property_icon.tsx)
  type PropertyIconSpec = 'corners' | 'delay' | 'h' | 'infinity' | 'loop' | 'loop_off' | 'loop_once' | 'loop_pingpong' | 'minus' | 'opacity' | 'path_trim_end' | 'path_trim_origin' | 'path_trim_start' | 'radius_all' | 'radius_bottom_left' | 'radius_bottom_right' | 'radius_top_left' | 'radius_top_right' | 'rotation' | 'time' | 'w' | 'x' | 'y'

