  const LAYER_BLUR_EFFECT = Symbol('figma.motion.layerBlur')

  export function textElements(
    node,
    {
      by,
      from = 'left',
      includeWhitespace = true,
      clipContent = false,
      transformOriginMode = 'MATCH',
      transformOrigin = { x: 0, y: 0 },
    },
  ) {
