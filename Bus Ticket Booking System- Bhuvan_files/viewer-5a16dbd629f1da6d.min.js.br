      {
        character: includeWhitespace ? 'CHARACTER' : 'CHARACTER_NO_WHITESPACE',
        word: 'WORD',
        line: 'LINE',
        paragraph: 'PARAGRAPH',
        CHARACTER: 'CHARACTER',
        CHARACTER_NO_WHITESPACE: 'CHARACTER_NO_WHITESPACE',
        WORD: 'WORD',
        LINE: 'LINE',
        PARAGRAPH: 'PARAGRAPH',
      }[by]
    const order = {
      left: 'LEFT_RIGHT',
      right: 'RIGHT_LEFT',
      center: 'CENTER_OUT',
      random: 'RANDOM',
      LEFT_RIGHT: 'LEFT_RIGHT',
      RIGHT_LEFT: 'RIGHT_LEFT',
      CENTER_OUT: 'CENTER_OUT',
      RANDOM: 'RANDOM',
    }[from]

    return {
      [TEXT_ELEMENTS_TARGET]: true,
      node,
      textElementDelayBehaviour: parseTextElementDelayBehaviour({
        enabled: true,
        grouping,
        delayMs: 0,
        order,
        clipContent,
        transformOriginMode,
        transformOrigin,
